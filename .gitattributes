# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.db binary
*.sqlite binary
*.tar binary
*.gz binary
*.zip binary
