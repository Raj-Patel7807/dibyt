# Multi-stage Dockerfile for Dibyt Web Management Console
# Stage 1: Build dashboard assets
FROM node:20-alpine AS builder

WORKDIR /build

COPY apps/dibyt-dashboard/package*.json ./
RUN npm ci

COPY apps/dibyt-dashboard ./
RUN npm run build

# Stage 2: Serve via unprivileged Nginx
FROM nginxinc/nginx-unprivileged:alpine-slim AS runtime

COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
