# Dibyt Server & CLI Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.

# Server Network Settings
DIBYT_DATA_BIND_ADDRESS=127.0.0.1
DIBYT_DATA_PORT=9080
DIBYT_MANAGEMENT_BIND_ADDRESS=127.0.0.1
DIBYT_MANAGEMENT_PORT=9081

# Concurrency & Resource Limits
DIBYT_MAX_PEER_CONNECTIONS=64
DIBYT_DEFAULT_WORKERS=4
DIBYT_CHUNK_SIZE_BYTES=65536
DIBYT_CHECKPOINT_INTERVAL_BYTES=1048576
DIBYT_LEASE_TTL_SECONDS=15
DIBYT_SOCKET_TIMEOUT_SECONDS=30

# Storage & Persistence Paths
DIBYT_DB_PATH=./dibyt.db
DIBYT_STAGING_DIR=./.dibyt-staging
DIBYT_LOG_LEVEL=info
DIBYT_LOG_FORMAT=console

# Security (Planned for Sprint 15)
DIBYT_TLS_ENABLED=false
DIBYT_TLS_CERT_PATH=
DIBYT_TLS_KEY_PATH=
DIBYT_API_AUTH_TOKEN=
